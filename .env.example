# 对外监听端口。容器内前后端始终共用 8080。
APP_BIND=127.0.0.1
APP_PORT=2033

# 仅空数据库首次启动时用于创建管理员。至少 12 个字符。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 两个值必须分别生成并长期保存，重启或升级时不能更换。
# JWT_SECRET 至少 32 个字符。
JWT_SECRET=
# MASTER_KEY 必须是 32 字节的 base64。
MASTER_KEY=

TZ=Asia/Shanghai

# 云端副本按需拉取到 DATA_DIR/tmp/material-pulls 后的可下载时长。
PULL_CACHE_TTL=15m

# Docker Compose 使用独立 PostgreSQL，只在内网监听。
POSTGRES_USER=paper
POSTGRES_DB=paper
POSTGRES_PASSWORD=

# 首次从旧 Docker SQLite 卷迁移时设置为 /app/data/paper.db。
# 目标 PostgreSQL 已有用户时会自动跳过，不会覆盖数据。
MIGRATE_FROM_SQLITE=

# 主端任务类型、并发、租约、心跳和从端运行配置都在管理台「系统 → 节点」
# 中保存到数据库，不再通过环境变量设置。

# 自建 RapidOCR（Compose 内网服务）。单机资源有限时保持 1。
# 容器 CPU 上限默认 1 核。
# RAPIDOCR_CPUS=1.0
# RAPIDOCR_WORKERS=1
# RAPIDOCR_THREADS=1
