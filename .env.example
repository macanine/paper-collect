# 对外监听端口。容器内前后端始终共用 8080。
APP_PORT=2033

# 仅空数据库首次启动时用于创建管理员。至少 12 个字符。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 两个值必须分别生成并长期保存，重启或升级时不能更换。
# JWT_SECRET 至少 32 个字符。
JWT_SECRET=
# MASTER_KEY 必须是 32 字节的 base64。
MASTER_KEY=

TZ=Asia/Shanghai

# Docker Compose 使用独立 PostgreSQL，只在内网监听。
POSTGRES_USER=paper
POSTGRES_DB=paper
POSTGRES_PASSWORD=

# 首次从旧 Docker SQLite 卷迁移时设置为 /app/data/paper.db。
# 目标 PostgreSQL 已有用户时会自动跳过，不会覆盖数据。
MIGRATE_FROM_SQLITE=

# Docker Compose 已为两个实例设置唯一 ID；本地单实例可留空。
# SQLite 模式禁止设置；并发设置按上游配额和单机资源调整。
# WORKER_INGEST_CONCURRENCY=1
# WORKER_REPLICATE_CONCURRENCY=2
# WORKER_ANALYZE_CONCURRENCY=2
# WORKER_INDEX_CONCURRENCY=2
# WORKER_LEASE_DURATION=2m
# WORKER_HEARTBEAT_INTERVAL=20s
# WORKER_POLL_INTERVAL=2s

# 自建 RapidOCR（Compose 内网服务）。单机资源有限时保持 1。
# 容器 CPU 上限默认 1 核。
# RAPIDOCR_CPUS=1.0
# RAPIDOCR_WORKERS=1
# RAPIDOCR_THREADS=1
